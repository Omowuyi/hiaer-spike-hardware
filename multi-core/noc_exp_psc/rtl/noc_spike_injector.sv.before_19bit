`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Module: noc_spike_injector.sv (CORRECTED)
// 
// Description:
//   Spike injector module that receives spikes from the NoC and forwards them
//   to the core's NoC Relay Event FIFO in the External Events Processor.
//
// CORRECTION from original:
//   - Original: Wrote directly to axon BRAM (incorrect)
//   - Corrected: Writes to NoC Relay Event FIFO (17-bit address passthrough)
//
// Integration Points:
//   - Input: Connected to noc_l1_bus spike output ports
//   - Output: Connected to external_events_processor's noc_relay_* interface
//
// Operation:
//   1. Receives 17-bit spike address from NoC L1 bus
//   2. Passes address to NoC Relay Event FIFO in EEP
//   3. EEP Phase 3 processes FIFO and writes to axon BRAM
//
// Spike Address Format (17 bits):
//   [16:13] - Neuron Group (0-15)
//   [12:0]  - Neuron index within group
//////////////////////////////////////////////////////////////////////////////////

import noc_pkg::*;

module noc_spike_injector #(
    parameter CORE_ID = 0
)(
    input  logic clk,
    input  logic resetn,
    
    // =========================================================================
    // Spike Input from NoC (from L1 bus)
    // =========================================================================
    input  logic [16:0] noc_spike_addr,
    input  logic        noc_spike_valid,
    output logic        noc_spike_ready,
    
    // =========================================================================
    // NoC Relay FIFO Output (to external_events_processor)
    // =========================================================================
    output logic [16:0] noc_relay_addr,    // 17-bit spike address (passthrough)
    output logic        noc_relay_valid,   // Write enable to FIFO
    input  logic        noc_relay_full,    // FIFO full from EEP
    
    // =========================================================================
    // Status/Debug
    // =========================================================================
    output logic [15:0] inject_count,      // Number of spikes injected this timestep
    output logic        overflow_error,    // Set if FIFO full when spike arrives
    
    // =========================================================================
    // Timestep sync (to reset counters)
    // =========================================================================
    input  logic        exec_run           // New timestep indicator
);

    // =========================================================================
    // Injection Logic
    // =========================================================================
    // Simple flow-through design with backpressure support
    
    logic [15:0] count_reg;
    logic        overflow_reg;
    
    // Ready when FIFO is not full
    assign noc_spike_ready = !noc_relay_full;
    
    // Pass spike directly to FIFO
    assign noc_relay_addr = noc_spike_addr;
    assign noc_relay_valid = noc_spike_valid && !noc_relay_full;
    
    // =========================================================================
    // Statistics Counters
    // =========================================================================
    
    always_ff @(posedge clk or negedge resetn) begin
        if (!resetn) begin
            count_reg <= 16'd0;
            overflow_reg <= 1'b0;
        end else begin
            // Reset counters on new timestep
            if (exec_run) begin
                count_reg <= 16'd0;
                overflow_reg <= 1'b0;
            end else begin
                // Count successful injections
                if (noc_spike_valid && !noc_relay_full) begin
                    count_reg <= count_reg + 1'b1;
                end
                
                // Track overflow (spike arrived but FIFO full)
                if (noc_spike_valid && noc_relay_full) begin
                    overflow_reg <= 1'b1;
                end
            end
        end
    end
    
    // =========================================================================
    // Output Assignments
    // =========================================================================
    
    assign inject_count = count_reg;
    assign overflow_error = overflow_reg;

endmodule


