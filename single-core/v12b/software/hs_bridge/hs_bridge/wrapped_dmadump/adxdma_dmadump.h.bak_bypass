#ifndef _ALPHADATA_ADXDMA_DMADUMP_H
#define _ALPHADATA_ADXDMA_DMADUMP_H

enum ExitCode {
  ExitCodeSuccess = 0,
  ExitCodeCannotOpenIndex      = 100,
  ExitCodeCannotOpenDMAEngine  = 101,
  ExitCodeNoSuchDMAEngine      = 102,
  ExitCodeNoSuchDMAMethod      = 103,
  ExitCodeBufferAllocFailed    = 104,
  ExitCodeBufferLockFailed     = 105,
  ExitCodeDMAReadFailed        = 106,
  ExitCodeDMAWriteFailed       = 107,
  /* NEW: window-related exit codes for the DMA bypass path */
  ExitCodeCannotOpenWindow     = 110,
  ExitCodeWindowWriteFailed    = 111,
  ExitCodeWindowReadFailed     = 112
};

enum DmaMethod {
  DmaMethodNormal = 0, /* Use ADXDMA_DMA{Read,Write} */
  DmaMethodLocked = 1, /* Use ADXDMA_DMA{Read,Write}Locked */
  DmaMethodNative = 2  /* Use OS-specific read or write functions */
};

/* When XDMA IP is configured for AXI stream interface, source, destination
** and length must be integral multiple of AXI width, in bytes. Since the
** maximum possible AXI width is 128 bytes, we align DMA buffers to this
** boundary in case the XDMA IP is configured for AXI stream interface. */
#define ADXDMA_DMA_BUFFER_ALIGNMENT (0x80)

#ifdef __cplusplus
extern "C" {
#endif

#if defined(__VXWORKS__) || defined(__vxworks)

int /* ExitCode */
adxdmaDMAReadB( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method);

int /* ExitCode */
adxdmaDMAReadW( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method);

int /* ExitCode */
adxdmaDMAReadD( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  ReadWriteMethod method);

int /* ExitCode */
adxdmaDMAReadQ( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method);

#endif

int /* ExitCode */
adxdmaDMARead( /* Entry point in VxWorks */
  unsigned int deviceIndex,
  unsigned int engineIndex,
  uint64_t     address,
  uint32_t     readCount,
  unsigned int wordSize,
  DmaMethod    dmaMethod,
  uint64_t data[],
  unsigned int dataElements,
  unsigned int dataStride);

#if defined(__VXWORKS__) || defined(__vxworks)

int /* ExitCode */
adxdmaWriteB( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method,
  ...);

int /* ExitCode */
adxdmaWriteW( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method,
  ...);

int /* ExitCode */
adxdmaWriteD( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method,
  ...);

int /* ExitCode */
adxdmaWriteQ( /* Entry point in VxWorks */
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method,
  ...);

#endif

int /* ExitCode */
adxdmaDMAWriteBuffer(
  unsigned int    deviceIndex,
  unsigned int    engineIndex,
  uint64_t        address,
  uint32_t        byteCount,
  DmaMethod       method,
  const void*     pBuffer);

/* ========================================================================= */
/* NEW: DMA bypass (window / memory-mapped BAR) support                      */
/* ========================================================================= */
/* adxdmaWindowWrite                                                          */
/*                                                                            */
/* Writes a buffer into the device through a PCIe BAR "window".               */
/* The bypass BAR (256 MB, prefetchable, 64-bit) is window index 1 in         */
/* the Alpha Data driver's enumeration for this bitstream - window 0 is      */
/* the small 64 KB control BAR used by the existing command interface.       */
/*                                                                            */
/* The offset parameter is the BYTE address within the window. When the      */
/* window's "PCIe to AXI Translation" is 0, offset maps 1:1 to the first     */
/* AXI address on the bypass bus. With our RTL wiring, that goes straight    */
/* into HBM channel 0 byte space, so:                                         */
/*       offset = hbm_row_address * 32                                        */
/*                                                                            */
/* Returns ExitCodeSuccess (0) on success.                                    */
/* ========================================================================= */
int /* ExitCode */
adxdmaWindowWrite(
  unsigned int    deviceIndex,
  unsigned int    windowIndex,
  uint64_t        offset,      /* byte offset into the window */
  uint32_t        byteCount,
  const void*     pBuffer);

/* Analogous read, useful for verifying synapses were written correctly. */
int /* ExitCode */
adxdmaWindowRead(
  unsigned int    deviceIndex,
  unsigned int    windowIndex,
  uint64_t        offset,      /* byte offset into the window */
  uint32_t        byteCount,
  void*           pBuffer);

#ifdef __cplusplus
}
#endif

#endif
