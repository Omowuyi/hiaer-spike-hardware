# cython: profile=True
import cython
import time
import logging

cdef extern from 'adxdma_dmadump.h':
    cpdef enum DmaMethod:
        DmaMethodNormal,
        DmaMethodLocked,
        DmaMethodNative

cdef extern from "stdint.h":
    #foo
    ctypedef int uint64_t
    ctypedef int uint32_t

cdef extern from "cmdline.cpp":
    #Ensures cmdline.c gets compiled
    # C is include here so that it doesn't need to be compiled externally
    pass



cdef extern from "cmdline.h":
     #"""Perform H5conversion
     #
     #Notes
     #-----
     #This definition esures that C_func_file.h gets included in the c code generated by Cython
     #and provides a function definition callable from cython code. Note that since C_func_file.h
     #already contains a decleration of multiply_by_10_in_C Cython won't actually genearte a decleration
     #corresponding to the one declared in this function in the generated c code.
     #"""
     #here we provide a definition of the function we want to call from python
     int dmadump(uint64_t *, unsigned int, unsigned int, int, size_t, unsigned int, unsigned int,
      unsigned int,
      uint64_t,
      #uint32_t,
      DmaMethod,
      unsigned int)
     int dmadump_bypass(uint64_t *, unsigned int,
       unsigned int,
       int,
       unsigned int,
       unsigned int,
       uint64_t)


     int dmadump_bypass(uint64_t *, unsigned int, unsigned int, int, unsigned int, unsigned int, uint64_t)

import numpy as np

def dma_dump(writeNotRead, nWriteData, wordSize, data, index, engineIndex, address, byteCount, dmaMethod, readCount): # 'arr' is a two-dimensional numpy array
    """Perform h5 conversion of the data
    Converts the raw data read from the opal kelly and returns the timeseries values recorded
    by the NISoC
    Parameters
    ----------
    write: bool
        if true write, if false read
    nWriteData : int
        number of elements to write
    wordSize : int
        size of each element
    engineIndex : int
        dma engine to use
    address : int
        starting index for transaction
    byteCount :
    DmaMethod :
    readCount : int
        number of bytes to read
    data : numpy array
        the data to stick in the buffer
    -----
    This function wraps the c function multiply_by_10_in_C used to perform h5 conversion
    """
    if (wordSize not in [1,2,4,8]):
        logging.error("invalid word size")

    #Cast as needed
    writeNotRead = int(writeNotRead)
    # Pack bytes into uint64 elements correctly (do NOT expand each byte to 8 bytes)
    if data.dtype != np.uint64:
        byte_view = np.ascontiguousarray(data).view(np.uint8)
        n_u64 = (byte_view.nbytes + 7) // 8
        packed = np.zeros(n_u64, dtype=np.uint64)
        packed.view(np.uint8)[:byte_view.nbytes] = byte_view
        data = packed
    else:
        data = data.astype(np.uint64)

    if not data.flags['C_CONTIGUOUS']:
        data = np.ascontiguousarray(data) # Makes a contiguous copy of the numpy array.
    cdef uint64_t[:] data_memview = data

#data can just be a list of 64bit integers, however i'm not sure how to read data out yet
    exitCode = dmadump(&data_memview[0], data_memview.shape[0], data_memview.strides[0]/data_memview.itemsize, writeNotRead, nWriteData, wordSize, index, engineIndex, address,
                dmaMethod, readCount)
    #arr_memview.strides returns stride values in number of bytes, so we must divide by the number of bytes in our item (in this case a double) and arr_memview.itemsize gives us this value.
    return exitCode, data

def dma_dump_read(wordSize, index, engineIndex, address, dmaMethod, readCount): # 'arr' is a two-dimensional numpy array
    """Perform h5 conversion of the data
    Converts the raw data read from the opal kelly and returns the timeseries values recorded
    by the NISoC
    Parameters
    ----------
    write: bool
        if true write, if false read
    nWriteData : int
        number of elements to write
    wordSize : int
        size of each element
    engineIndex : int
        dma engine to use
    address : int
        starting index for transaction
    byteCount :
    DmaMethod :
    readCount : int
        number of bytes to read
    data : numpy array
        the data to stick in the buffer
    -----
    This function wraps the c function multiply_by_10_in_C used to perform h5 conversion
    """ 
    writeNotRead = 0
    nWriteData = 0
    data = np.zeros(readCount)
    
    if (wordSize not in [1,2,4,8]):
        logging.error("invalid word size")

    #Cast as needed
    data = data.astype(np.uint64)

    if not data.flags['C_CONTIGUOUS']:
        data = np.ascontiguousarray(data) # Makes a contiguous copy of the numpy array.
    cdef uint64_t[:] data_memview = data

#data can just be a list of 64bit integers, however i'm not sure how to read data out yet
    exitCode = dmadump(&data_memview[0], data_memview.shape[0], data_memview.strides[0]/data_memview.itemsize, writeNotRead, nWriteData, wordSize, index, engineIndex, address,
                dmaMethod, readCount)
    #arr_memview.strides returns stride values in number of bytes, so we must divide by the number of bytes in our item (in this case a double) and arr_memview.itemsize gives us this value.
    return exitCode, data

def dma_dump_write(data, nWriteData, wordSize, index, engineIndex, address, dmaMethod): # 'arr' is a two-dimensional numpy array
    """Perform h5 conversion of the data
    Converts the raw data read from the opal kelly and returns the timeseries values recorded
    by the NISoC
    Parameters
    ----------
    write: bool
        if true write, if false read
    nWriteData : int
        number of elements to write
    wordSize : int
        size of each element
    engineIndex : int
        dma engine to use
    address : int
        starting index for transaction
    byteCount :
    DmaMethod :
    readCount : int
        number of bytes to read
    data : numpy array
        the data to stick in the buffer
    -----
    This function wraps the c function multiply_by_10_in_C used to perform h5 conversion
    """
    if (wordSize not in [1,2,4,8]):
        logging.error("invalid word size")

    readCount = 0
    writeNotRead = 1
    #Cast as needed
    # FIX: pack bytes into uint64 without expanding each byte to 8 bytes
    if data.dtype != np.uint64:
        byte_view = np.ascontiguousarray(data).view(np.uint8)
        n_u64 = (byte_view.nbytes + 7) // 8
        data = np.zeros(n_u64, dtype=np.uint64)
        data.view(np.uint8)[:byte_view.nbytes] = byte_view
    else:
        data = data.astype(np.uint64)

    if not data.flags['C_CONTIGUOUS']:
        data = np.ascontiguousarray(data) # Makes a contiguous copy of the numpy array.
    cdef uint64_t[:] data_memview = data

#data can just be a list of 64bit integers, however i'm not sure how to read data out yet
    exitCode = dmadump(&data_memview[0], data_memview.shape[0], data_memview.strides[0]/data_memview.itemsize, writeNotRead, nWriteData, wordSize, index, engineIndex, address,
                dmaMethod, readCount)
    #arr_memview.strides returns stride values in number of bytes, so we must divide by the number of bytes in our item (in this case a double) and arr_memview.itemsize gives us this value.
    return exitCode
def dma_bypass_write(data, offset, device_index=0, window_index=1):
    """Write data to the FPGA via the DMA bypass BAR (memory-mapped path).

    Unlike dma_dump_write (which sends command packets through the AXI-Stream
    path and requires a CMD_HBM_RW wrapper), this function writes raw bytes
    straight into the HBM byte space via the xdma m_axib -> hbm_xbar route.

    Parameters
    ----------
    data : numpy array
        Buffer to write. Will be reinterpreted as bytes. Any shape/dtype is
        accepted; contiguous memory is ensured.
    offset : int
        Byte offset into the bypass window. With our current RTL (window
        PCIe-to-AXI translation = 0, bypass crossbar straight to HBM ch0),
        this equals:
            offset = hbm_row_address * 32
    device_index : int, default 0
        Alpha Data device index. 0 on a single-FPGA host.
    window_index : int, default 1
        Which BAR window to use. 1 = the new 256 MB bypass BAR. Window 0
        is the existing 64 KB control BAR (don't use for synapse writes).

    Returns
    -------
    exitCode : int
        0 on success. Non-zero = failure (see ExitCode enum in
        adxdma_dmadump.h).
    """
    # View the supplied buffer as a byte string of known length, then
    # copy into a uint64 backing array for the C extern.
    byte_view = np.ascontiguousarray(data).view(np.uint8)
    byte_count = byte_view.nbytes

    # Round up to uint64 element count for the backing array.
    n_u64 = (byte_count + 7) // 8
    buf = np.zeros(n_u64, dtype=np.uint64)
    # Copy bytes in
    buf.view(np.uint8)[:byte_count] = byte_view

    if not buf.flags['C_CONTIGUOUS']:
        buf = np.ascontiguousarray(buf)

    cdef uint64_t[:] buf_memview = buf

    exitCode = dmadump_bypass(
        &buf_memview[0],
        buf_memview.shape[0],
        byte_count,
        1,              # bWriteNotRead = write
        device_index,
        window_index,
        offset)
    return exitCode


def dma_bypass_read(byte_count, offset, device_index=0, window_index=1):
    """Read bytes from the FPGA via the DMA bypass BAR.

    Useful for verifying what was written (readback of HBM contents).

    Parameters
    ----------
    byte_count : int
        Number of bytes to read.
    offset : int
        Byte offset into the bypass window (= hbm_row_address * 32).
    device_index : int, default 0
    window_index : int, default 1

    Returns
    -------
    (exitCode, data) : tuple
        exitCode: 0 on success.
        data: numpy uint8 array of length byte_count (valid only if exitCode==0).
    """
    n_u64 = (byte_count + 7) // 8
    buf = np.zeros(n_u64, dtype=np.uint64)
    if not buf.flags['C_CONTIGUOUS']:
        buf = np.ascontiguousarray(buf)

    cdef uint64_t[:] buf_memview = buf

    exitCode = dmadump_bypass(
        &buf_memview[0],
        buf_memview.shape[0],
        byte_count,
        0,              # bWriteNotRead = read
        device_index,
        window_index,
        offset)

    # Return the byte-view slice that was filled
    data_bytes = buf.view(np.uint8)[:byte_count].copy()
    return exitCode, data_bytes
