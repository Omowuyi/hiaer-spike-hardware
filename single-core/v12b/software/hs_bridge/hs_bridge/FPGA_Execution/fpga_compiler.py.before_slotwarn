    def _syn64_entry(self, w):
        """One 64-bit synapse entry as a 64-character bit string.

        {op[2:0], dest[12:0], weight[15:0], delay[5:0], syn_type[3:0],
         stdp_tag[3:0], src[17:0]}   -- matches internal_events_processor.v

        Accepts (op, dest, weight), (op, dest, weight, delay, src) or (op, dest, weight, delay, src, rule):
        rule = plasticity rule slot 1..15 written to stdp_tag (0 or absent = static synapse).
        """
        # A 5-tuple carries its own delay; a 3-tuple falls back to the
        # network-wide default, which is how delay is specified until the
        # connectome grows a per-synapse field.
        # FIX W: a spike entry is op=4 with the address in the low 17 bits,
        # exactly as the 32-bit path encodes it.  Dropping these was making
        # affected neurons unable to report spikes at all in 64-bit mode.
        if w[0] == 1:
            return (np.binary_repr(4, SYN_OP_BITS)
                    + 44 * '0'
                    + np.binary_repr(int(w[1]) & 0x1FFFF, 17))
        if w[0] != 0:
            raise ValueError("unhandled synapse opcode %r" % (w[0],))
        # empty slot: compile_network fills unused columns with the placeholder (0, 0, 0).  It is not a synapse
        # and must not carry the network-wide delay (with syn_delay > 0 every empty slot became a delayed weight-0 entry)
        if len(w) == 3 and tuple(int(x) for x in w) == (0, 0, 0):
            return np.binary_repr(0, 64)
        delay = int(w[3]) if len(w) > 3 and w[3] is not None else getattr(self, 'syn_delay', 0)
        src   = int(w[4]) if len(w) > 4 and w[4] is not None else 0
        tag   = int(w[5]) if len(w) > 5 else 0
        if not 0 <= tag <= 15:
            raise ValueError("plasticity rule slot %d outside 0-15" % tag)
        if not 0 <= delay <= 63:
            raise ValueError("synapse delay %d outside 0-63" % delay)
        return (np.binary_repr(0, SYN_OP_BITS)
                + np.binary_repr(int(w[1]), SYN_ADDR_BITS)
                + np.binary_repr(int(w[2]), SYN_WEIGHT_BITS)
                + np.binary_repr(delay, 6)
                + np.binary_repr(0, 4)          # syn_type, reserved
                + np.binary_repr(tag, 4)        # stdp_tag: plasticity rule slot, 0 = static
                + np.binary_repr(src, 18))

    def _create_synapses_64(self, simDump = False):
        """64-bit emit.  Each logical row of 8 entries becomes TWO HBM rows of
        4 entries, written at SYN_BASE_ADDR + 2r and + 2r + 1, preserving
        entry order.  Pointer offsets are doubled to match."""
        dump = [] if simDump else None
        bigCmdList = []
        for r, d in enumerate(self.synapses):
            # FIX W: was `if w[0] == 0`, which dropped spike entries and slid
            # everything after them into the wrong slot.  Encode every entry
            # and keep its position.
            entries = [self._syn64_entry(w) for w in d]
            while len(entries) < 8:
                entries.append(np.binary_repr(0, 64))
            for half in (0, 1):
                cmd = []
                for b in entries[half * 4:(half + 1) * 4]:
                    cmd += [int(b[i:i + 8], 2) for i in range(0, 64, 8)]
                # Measured: group quad gq reads HBM row 3-gq, so slot
                # quad q must be written at row 3-q.  Reversal applies
                # within each 16-group unit (2 logical rows = 4 HBM rows).
                _unit = r // 2
                _within = 2 * (r % 2) + half
                _hbm_row_reversed = 4 * _unit + (3 - _within)
                rowAddress = '1' + np.binary_repr(SYN_BASE_ADDR + _hbm_row_reversed, 23)
                cmd = (self.HBM_OP_RW_LIST
                       + [int(rowAddress[:8], 2), int(rowAddress[8:16], 2),
                          int(rowAddress[16:], 2)] + cmd)
                cmd = np.flip(np.array(cmd, dtype=np.uint64))
                if simDump:
                    h = ['{:0{width}x}'.format(i, width=2) for i in cmd]
                    h.reverse()
                    dump.append(''.join(h))
                else:
                    bigCmdList.append(cmd)
        if simDump:
            return dump
        split = np.concatenate(bigCmdList)
        while split.size:
            element = split[:640]
            split = split[640:]
            dmadump.dma_dump_write(element, len(element), 1, 0, 0, 0,
                                   dmadump.DmaMethodNormal)

    @staticmethod
    def _parse_write(h):
        """CMD 2 write packet (simDump hex, most significant byte first) -> (row, 256-bit value)."""
        b = bytes.fromhex(h)
        addr = int.from_bytes(b[29:32], 'big')
        if b[0] != 2 or not (addr >> 23) & 1:
            raise ValueError("not a CMD 2 write packet")
        return addr & 0x7FFFFF, int.from_bytes(b[32:64], 'big')

    def _write_packet(self, row, value):
        a = '1' + np.binary_repr(row, 23)
        cmd = self.HBM_OP_RW_LIST + [int(a[:8], 2), int(a[8:16], 2), int(a[16:], 2)] + list(value.to_bytes(32, 'big'))
        return np.flip(np.array(cmd, dtype=np.uint64))

    def plasticity_rows(self, n_axons, n_neurons, free_row=None):
        """Plasticity layout for this core (64-bit synapses only).  Returns (packets, cfg_pairs, image, new_rows):
        CMD 2 write packets for the extra rows, the base-register pairs for opcode 19, the compiled image as written
        (src filled on plastic entries; those synapse rows are included in the packets), and the extra rows."""
        from hs_bridge.FPGA_Execution import plasticity as PL
        image = {}
        for h in (self.create_axon_ptrs(simDump=True, syn_64bit=True) + self.create_neuron_ptrs(simDump=True, syn_64bit=True)
                  + self._create_synapses_64(simDump=True)):
            r, v = self._parse_write(h if isinstance(h, str) else h[0])
            image[r] = v
        before = dict(image)
        if free_row is None:
            free_row = max(image) + 1 if image else 0
        new, pairs = PL.layout(image, n_axons, n_neurons, free_row)
        rows = dict(new)
        rows.update({r: v for r, v in image.items() if before.get(r) != v})   # synapse rows whose src was filled
        return [self._write_packet(r, v) for r, v in sorted(rows.items())], pairs, image, new

    def create_script(self, fname, simDump = False, syn_64bit = False,
                      syn_delay = 0):
        # Recorded before any emit so _syn64_entry can see it.  Delay only
        # has meaning in the 64-bit format; the 32-bit entry has no field
        # for it, so a nonzero delay there is a caller error.
        if syn_delay and not syn_64bit:
            raise ValueError("syn_delay requires syn_64bit=True -- the "
                             "32-bit synapse entry has no delay field")
        if not 0 <= syn_delay <= 63:
            raise ValueError("syn_delay %d outside 0-63" % syn_delay)
        self.syn_delay = syn_delay
        """Generates the bash file to program HBM for the current network

        Generates the bash file needed to program the axon pointers, neuron pointers, and synapses into hbm

        Parameters
        ----------
        fname : int
            The filename to write the script to
        """
        axon_ptrs = self.create_axon_ptrs(simDump, syn_64bit)
        neuron_ptrs = self.create_neuron_ptrs(simDump, syn_64bit)
        synapses = self.create_synapses(simDump, syn_64bit)
        # delay-slot capacity check: a slot holds 1023 entries per core, and every delayed entry can land on one step
        if syn_64bit:
            _nd = sum(1 for _d in self.synapses for _w in _d
                      if len(_w) >= 3 and _w[0] == 0
                      and not (len(_w) == 3 and tuple(int(_x) for _x in _w) == (0, 0, 0))
                      and (int(_w[3]) if len(_w) > 3 else getattr(self, 'syn_delay', 0)) > 0)
            if _nd > 1023:
                _msg = ('core image has %d delayed synapse entries; a delay slot holds 1023 per core, so if more than '
                        '1023 arrive on the same step the excess is refused (error_status bit 18)' % _nd)
                warnings.warn(_msg); logging.warning(_msg)

        if simDump:
            return axon_ptrs, neuron_ptrs, synapses

