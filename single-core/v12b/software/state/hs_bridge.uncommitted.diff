+def bitstream_features(coreID=0, refresh=False, max_reads=2000):
+    """Feature bits reported by the bitstream for this core (0 for bitstreams without a feature
+    word).  Cached per core: call with refresh=True after flashing a different bitstream."""
+    if coreID in _features and not refresh:
